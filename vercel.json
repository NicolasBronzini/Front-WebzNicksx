{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "webznick.app" }],
            "destination": "https://www.webznick.app/$1",
            "permanent": true
        }
    ],
    "rewrites":[
        {
            "source":"/(.*)",
            "destination":"/"
        }
    ]
}